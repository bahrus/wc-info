    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "typescript-json-schema": "0.65.1"
  },
  "devDependencies": {
    "custom-elements-manifest": "2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/wc-info.git"
  },
  "author": "anderson.bruce.b@gmail.com",
